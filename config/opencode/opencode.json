{
	"$schema": "https://opencode.ai/config.json",
	"theme": "opencode",
	"model": "openai/gpt-5.3-codex",
	"tui": {
		"scroll_acceleration": {
			"enabled": true
		}
	},
	"plugin": [
		"file:///Users/andrew/dot/config/opencode/plugin/opencode-anthropic-auth.mjs",
		"opencode-rate-limit-fallback",
		"opencode-comments-plugin",
		"file:///Users/andrew/dot/config/opencode/plugin/question-sound.js",
		"file:///Users/andrew/dot/config/opencode/plugin/preemptive-compaction.js",
		"file:///Users/andrew/dot/config/opencode/plugin/interrupt-on-x.js"
	],
	"mcp": {
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["bunx", "-y", "opensrc-mcp"]
		},
		"websearch": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
			"enabled": true
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"playwriter": {
			"type": "local",
			"command": ["bunx", "playwriter@latest"],
			"enabled": true,
			"environment": {
				"PLAYWRITER_AUTO_ENABLE": "1"
			}
		},
		"overdo": {
			"type": "local",
			"enabled": true,
			"command": [
				"node",
				"/Users/andrew/dev/overdo/packages/overdo-mcp/bin/overdo-mcp-server.mjs"
			]
		}
	},
	"permission": {
		"external_directory": {
			"*": "ask",
			"/tmp": "allow",
			"/tmp/*": "allow",
			"/private/tmp": "allow",
			"/private/tmp/*": "allow",
			"env:$TMPDIR": "allow",
			"env:$TMPDIR/*": "allow"
		}
	},
	"provider": {
		"openai": {
			"models": {
				"gpt-5.3-codex": {
					"options": {
						"reasoningEffort": "medium"
					}
				}
			}
		},
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "LM Studio (local)",
			"options": {
				"baseURL": "http://localhost:1234/v1"
			},
			"models": {
				"qwen/qwen3-30b-a3b-2507": {
					"name": "Qwen 3 30B a3b (local)"
				}
			}
		}
	}
}

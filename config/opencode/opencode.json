{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "model": "openai/gpt-5.3-codex",
  "default_agent": "hephaestus",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "plugin": [
    "opencode-anthropic-auth@0.0.13",
    "file:///Users/andrew/dot/config/opencode/plugin/question-sound.js",
    "oh-my-opencode@latest"
  ],
  "mcp": {
    "opensrc": {
      "enabled": true,
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "opensrc-mcp"
      ]
    },
    "playwriter": {
      "type": "local",
      "command": [
        "bunx",
        "playwriter@latest"
      ],
      "enabled": true,
      "environment": {
        "PLAYWRITER_AUTO_ENABLE": "1"
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/private/tmp": "allow",
      "/private/tmp/*": "allow",
      "env:$TMPDIR": "allow",
      "env:$TMPDIR/*": "allow"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.3-codex": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3-30b-a3b-2507": {
          "name": "Qwen 3 30B a3b (local)"
        }
      }
    }
  }
}

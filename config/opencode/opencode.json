{
	"$schema": "https://opencode.ai/config.json",
	"theme": "opencode",
	"model": "openai/gpt-5.4",
	"default_agent": "build",
	"tui": {
		"scroll_acceleration": {
			"enabled": true
		}
	},
	"plugin": [
		"@ex-machina/opencode-anthropic-auth",
		"opencode-rate-limit-fallback",
		"opencode-comments-plugin",
		"file:///{env:HOME}/dot/config/opencode/plugin/question-sound.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/interrupt-on-x.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/never-stop.ts",
		"@plannotator/opencode@latest"
	],
	"mcp": {
		"executor": {
			"type": "remote",
			"url": "http://127.0.0.1:8788/mcp",
			"enabled": true,
			"timeout": 10000
		},
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["bunx", "-y", "opensrc-mcp"]
		},
		"fff": {
			"enabled": true,
			"type": "local",
			"command": ["/Users/andrew/.local/bin/fff-mcp"]
		},
		"websearch": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
			"enabled": true
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"refero": {
			"type": "remote",
			"url": "https://api.refero.design/mcp",
			"enabled": true
		},
		"daisyui-blueprint": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "daisyui-blueprint@latest"],
			"environment": {
				"LICENSE": "{env:DAISYUI_LICESE}",
				"EMAIL": "{env:EMAIL}"
			}
		}
	},
	"permission": {
		"external_directory": {
			"*": "ask",
			"/tmp": "allow",
			"/tmp/*": "allow",
			"/private/tmp": "allow",
			"/private/tmp/*": "allow",
			"{env:$TMPDIR}": "allow",
			"{env:$TMPDIR}/*": "allow",
			"{env:$HOME}/.local/share/opensrc/*": "allow"
		}
	},
	"provider": {
		"openai": {
			"models": {
				"gpt-5.4": {
					"options": {
						"reasoningEffort": "medium"
					}
				}
			}
		}
	}
}

{
	"$schema": "https://opencode.ai/config.json",
	"theme": "opencode",
	"model": "opencode/gpt-5.4",
	"default_agent": "build",
	"tui": {
		"scroll_acceleration": {
			"enabled": true
		}
	},
	"plugin": [
		"@ex-machina/opencode-anthropic-auth",
		"opencode-rate-limit-fallback",
		"opencode-comments-plugin",
		"file:///{env:HOME}/dot/config/opencode/plugin/question-sound.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/interrupt-on-x.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/never-stop.ts",
		"@plannotator/opencode@latest"
	],
	"mcp": {
		"executor": {
			"type": "remote",
			"url": "http://127.0.0.1:8788/mcp",
			"enabled": true,
			"timeout": 10000
		},
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["bunx", "-y", "opensrc-mcp"]
		},
		"fff": {
			"enabled": true,
			"type": "local",
			"command": ["/Users/andrew/.local/bin/fff-mcp"]
		}
	},
	"permission": {
		"external_directory": {
			"*": "ask",
			"/tmp": "allow",
			"/tmp/*": "allow",
			"/private/tmp": "allow",
			"/private/tmp/*": "allow",
			"{env:$TMPDIR}": "allow",
			"{env:$TMPDIR}/*": "allow",
			"{env:$HOME}/.local/share/opensrc/*": "allow"
		}
	},
	"provider": {
		"openai": {
			"models": {
				"gpt-5.4": {
					"options": {
						"reasoningEffort": "medium"
					}
				}
			}
		},
		"fireworks-ai": {
			"options": {
				"apiKey": "{env:FIREWORKS_API_KEY}"
			},
			"models": {
				"accounts/fireworks/routers/kimi-k2p5-turbo": {
					"id": "accounts/fireworks/routers/kimi-k2p5-turbo",
					"name": "Kimi K2.5 Turbo (Developer Pass)",
					"family": "kimi",
					"attachment": false,
					"reasoning": true,
					"tool_call": true,
					"temperature": true,
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					},
					"limit": {
						"context": 256000,
						"output": 256000
					}
				}
			}
		}
	}
}

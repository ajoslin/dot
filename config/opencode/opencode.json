{
	"$schema": "https://opencode.ai/config.json",
	"theme": "opencode",
	"model": "openai/gpt-5.3-codex",
	"tui": {
		"scroll_acceleration": {
			"enabled": true
		}
	},
	"plugin": [
		"file:///{env:HOME}//dot/config/opencode/plugin/opencode-anthropic-auth.mjs",
		"opencode-rate-limit-fallback",
		"opencode-comments-plugin",
		"file:///{env:HOME}/dot/config/opencode/plugin/question-sound.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/preemptive-compaction.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/interrupt-on-x.js"
	],
	"mcp": {
		"opensrc": {
			"enabled": true,
			"type": "local",
			"command": ["bunx", "-y", "opensrc-mcp"]
		},
		"websearch": {
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp?tools=web_search_exa",
			"enabled": true
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"playwriter": {
			"type": "local",
			"command": ["bunx", "playwriter@latest"],
			"enabled": true,
			"environment": {
				"PLAYWRITER_AUTO_ENABLE": "1"
			}
		}
	},
	"permission": {
		"external_directory": {
			"*": "ask",
			"/tmp": "allow",
			"/tmp/*": "allow",
			"/private/tmp": "allow",
			"/private/tmp/*": "allow",
			"env:$TMPDIR": "allow",
			"env:$TMPDIR/*": "allow"
		}
	},
	"provider": {
		"openai": {
			"models": {
				"gpt-5.3-codex": {
					"options": {
						"reasoningEffort": "medium"
					}
				}
			}
		}
	}
}

{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "deep",
	"mcp": {
		"intercom": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.intercom.com/mcp"
		},
		"cloudflare": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.cloudflare.com/mcp"
		},
		"exa": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.exa.ai/mcp"
		},
		"fff": {
			"command": ["/Users/andrew/.local/bin/fff-mcp"],
			"enabled": true,
			"type": "local"
		},
		"opensrc": {
			"command": ["bunx", "-y", "opensrc-mcp"],
			"enabled": true,
			"type": "local"
		}
	},
	"model": "opencode/gpt-5.4",
	"permission": {
		"external_directory": {
			"*": "deny",
			"{env:$HOME}/.local/share/opensrc/*": "allow",
			"{env:$TMPDIR}": "allow",
			"{env:$TMPDIR}/*": "allow",
			"/private/tmp": "allow",
			"/private/tmp/*": "allow",
			"/tmp": "allow",
			"/tmp/*": "allow"
		}
	},
	"plugin": [
		"file:///{env:HOME}/dot/config/opencode/plugin/command-guard.ts",
		"@ex-machina/opencode-anthropic-auth@1.4.0",
		"opencode-rate-limit-fallback",
		"opencode-comments-plugin",
		"file:///{env:HOME}/dot/config/opencode/plugin/question-sound.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/interrupt-on-x.js",
		"file:///{env:HOME}/dot/config/opencode/plugin/never-stop.ts"
	],
	"provider": {
		"fireworks-ai": {
			"models": {
				"accounts/fireworks/models/glm-5p1": {
					"attachment": true,
					"family": "glm",
					"id": "accounts/fireworks/models/glm-5p1",
					"limit": {
						"context": 128000,
						"output": 16384
					},
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					},
					"name": "GLM-5-Plus",
					"reasoning": true,
					"temperature": true,
					"tool_call": true
				},
				"accounts/fireworks/routers/kimi-k2p5-turbo": {
					"attachment": true,
					"family": "kimi",
					"id": "accounts/fireworks/routers/kimi-k2p5-turbo",
					"limit": {
						"context": 256000,
						"output": 256000
					},
					"modalities": {
						"input": ["text", "image"],
						"output": ["text"]
					},
					"name": "Kimi K2.5 Turbo (Developer Pass)",
					"reasoning": true,
					"temperature": true,
					"tool_call": true
				}
			},
			"options": {
				"apiKey": "{env:FIREWORKS_API_KEY}"
			}
		},
		"openai": {
			"models": {
				"gpt-5.4": {
					"options": {
						"reasoningEffort": "medium"
					}
				}
			}
		}
	},
	"theme": "opencode",
	"tui": {
		"scroll_acceleration": {
			"enabled": true
		}
	}
}
